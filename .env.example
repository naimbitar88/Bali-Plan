# Firebase web config — copy this file to `.env.local` and paste your project's values.
# These keys are NOT secret (they ship in the client); access is controlled by firestore.rules.
# Without these, the app still runs in local-only mode (no live sharing).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
